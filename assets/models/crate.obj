v 0.50 0.00 -0.50  0.364 0.259 0.147
v -0.50 0.00 -0.50  0.364 0.259 0.147
v -0.50 0.00 0.50  0.364 0.259 0.147
v -0.50 1.00 0.50  0.520 0.370 0.210
v -0.50 1.00 -0.50  0.520 0.370 0.210

