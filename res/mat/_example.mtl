# comment

TEXTURES:

# list of image files

A diffuse.png
B specular_emissive_compactnormal.jpg
C normal.jpg
D displacement.jpg

OUTPUT:

# OPTIONALLY LIST STATIC FORMATS INSTEAD OF DEFINING OUTPUT:
# RGB, RGB, INDEXED: palette_name, RGB565, ARGB1555

# colors

R A -> r
G A -> g
B A -> b

# alpha

A A -> a

# normals

NX C -> r
NY C -> g
NZ C -> b

# displacement

DU D -> r
DV D -> g

# specular

S B -> r

# emissive

E B -> g

# compact normal

CN B -> b

PROPERTIES:

opacity -> 1.0                     # default is 1.0

# 1.0 = pixel displaces to edge of texture when set to max displacement
# 0.0 = no displacement
displace_u_strength -> 1.0         # default is 0.5
displace_v_strength -> 1.0         # default is 0.5

emissive_strength -> 1.0           # default is 1.0

specular_strength -> 1.0           # default is 1.0

# 0.0 = infinite normal scope with only x and y variation
# 10.0 = precise angles, vary narrow scope
compact_normal_precision -> 4.0    # default is 4.0

